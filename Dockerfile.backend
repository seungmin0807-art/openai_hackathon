FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && mkdir -p /app/.data && chown -R node:node /app/.data
COPY --chown=node:node server.mjs voice-policy.mjs learning-log-store.mjs transcription-adapter.mjs care-reports.mjs care-repository.mjs care-learning-store.mjs app-session-access.mjs ./
COPY --chown=node:node public/visit-state.js public/visit-plans.js public/touch-cases.js public/tool-challenges.js public/transcript-policy.js ./public/
USER node
ENV NODE_ENV=production \
    DEPLOYMENT_MODE=separated \
    SERVE_STATIC=false \
    HOST=0.0.0.0 \
    PORT=3000 \
    OPENAI_CHILD_DATA_APPROVED=false
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.mjs"]
