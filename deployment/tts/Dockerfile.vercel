# Build context is the repository root. Existing public ONNX weights are downloaded
# at build time from their pinned revision, never through a generation service.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git libgomp1 libsndfile1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY voice/requirements-lock.txt /app/voice/requirements-lock.txt
RUN pip install --no-cache-dir -r /app/voice/requirements-lock.txt
COPY voice/service.py voice/runtime.py voice/download_models.py voice/SDK-LICENSE.txt voice/MODEL-LICENSE.txt /app/voice/
RUN python /app/voice/download_models.py
COPY deployment/tts/entrypoint.py /app/deployment/tts/entrypoint.py
RUN useradd --system --uid 10001 --create-home mori && chown -R mori:mori /app
USER mori
ENV PYTHONUNBUFFERED=1 PORT=8080 TTS_THREADS=2 TTS_VOICE=F4
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=120s --retries=3 CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8080')+'/health',timeout=2)"
CMD ["python", "deployment/tts/entrypoint.py"]
